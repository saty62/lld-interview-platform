# ==============================================================================
# LLD Arena Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Optional: Google Gemini API Key for AI-Assisted Qualitative Semantic Evaluation
# If omitted, LLD Arena operates 100% offline using its built-in Dynamic Heuristic Evaluator.
# GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: OpenAI API Key (alternative AI provider)
# OPENAI_API_KEY=your_openai_api_key_here
